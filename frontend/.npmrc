# 内网 / 国内环境使用国内镜像源，加速安装；若公司有私有 Nexus，替换为私有源
registry=https://registry.npmmirror.com

# Windows 下若没有开启「开发者模式」，pnpm 默认的符号链接式 node_modules
# 会因为权限不足而创建出空目录（现象：xxx is not recognized / Cannot find module）。
# 因此改用 hoisted 扁平布局，并对所有工作区包强制复制为硬链接。
node-linker=hoisted

# 仓库缓存放到项目上一级目录，避免 E:\ 根目录的写入权限问题
store-dir=E:\能源产效管理平台\.pnpm-store

strict-peer-dependencies=false
auto-install-peers=true
