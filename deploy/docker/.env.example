# ══════════════════════════════════════════════════════════════
# 能源产效管理系统 · 容器环境变量模板
#
# 用法：cp .env.example .env   然后把下面 4 个「必填」项换成真实值。
#   快速生成一个安全的密钥：  openssl rand -base64 50
#
# ⚠ .env 已在 .gitignore 与 .dockerignore 里，绝不会入库、也不会进镜像层。
# ⚠ 本文件里**不要写行尾注释**：compose 的 dotenv 解析会把 # 之后的内容
#    当成值的一部分，口令就会莫名其妙多出一截。注释一律单起一行。
# ══════════════════════════════════════════════════════════════

# ── 版本 ────────────────────────────────────────────────────
# 镜像标签用的版本号。留空则用 docker-compose.yml 里的默认值。
# 这里显式写出来是为了发版时**只改一处**就能对齐前后端镜像与离线包名。
EEP_VERSION=1.5.4

# ── 数据库 ──────────────────────────────────────────────────
# 留 EEP_DB_HOST=mysql 时用的是 compose 自带的 MySQL 容器；
# 要连现场已有的 MySQL，改成它的地址即可（此时可自行去掉 mysql 服务，
# 见 README 第 6 节；库不存在且账号有 CREATE 权限时后端会自动建库）。
EEP_DB_HOST=mysql
EEP_DB_PORT=3306
EEP_DB_NAME=eep_energy
EEP_DB_USER=eep

# 必填：Django 连库用的口令。compose 会用它同时创建 MySQL 账号，
# 缺了这个值 docker compose 直接拒绝启动（不会带着空口令起来再报错）。
EEP_DB_PASSWORD=

# 必填：仅容器内 MySQL 的 root 口令。后端不用它，
# 但它是首次初始化数据卷时唯一能建号建库的凭据，不能省。
EEP_DB_ROOT_PASSWORD=

# ── 后端 ────────────────────────────────────────────────────
# 必填：Django SECRET_KEY。留空会退回代码里的 dev-only 占位值，
# 那等于所有部署共用同一把密钥，签名 cookie 可被伪造。
EEP_SECRET_KEY=

# 生产必须是 false。DEBUG=true 会把堆栈和 SQL 直接回给浏览器。
EEP_DEBUG=false

# Django 的主机名白名单，逗号分隔。nginx 转发时带的是用户浏览器里的
# Host（很可能是 http://10.x.x.x/ 这种裸 IP），留空会触发 DisallowedHost
# → 页面能打开、接口全 400，现象非常难查。
#   *      厂区内部机器最省事，但等于任何 Host 都接受；
#   外面能访问时建议写死：localhost,127.0.0.1,你的域名或IP
EEP_ALLOWED_HOSTS=*

# 对外 HTTP 端口。被占用时改成 8080 之类，访问地址也要跟着换。
EEP_HTTP_PORT=80

# ── gunicorn（后端并发）────────────────────────────────────
# 经验值：worker ≈ CPU 核数 × 2 + 1，但每个 worker 常驻约 150MB 内存。
# 2 核 4GB 的工控机保持 2~3 就够（内部系统，并发就是个位数）。
EEP_GUNICORN_WORKERS=3
EEP_GUNICORN_THREADS=2
# 报表导出、跨月汇总这类慢接口要留够时间；太短会出现「页面转圈后 502」
EEP_GUNICORN_TIMEOUT=120

# ── 采集 ────────────────────────────────────────────────────
# 每隔多少秒跑一轮 collect --if-due。--if-due 会先查本小时是否已采过，
# 所以 300 秒一轮等价于「每小时采一次，错过自动补」，不要改成 60 去追实时值。
# 关掉采集：docker compose stop collector（接口与页面不受影响）
EEP_COLLECT_INTERVAL=300

# 启动时等数据库端口的最长秒数。首次给 MySQL 建数据卷要 30~60 秒。
EEP_DB_WAIT_SECONDS=120
