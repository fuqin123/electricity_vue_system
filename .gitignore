# ══════════════════════════════════════════════════════════════
# 能源产效管理系统 · 仓库忽略清单
#
# 规范要求（《项目规范》1.3）：严禁提交生产密钥、客户数据、隐私信息。
# ══════════════════════════════════════════════════════════════

# ── 依赖 ────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 构建产物 ────────────────────────────────────────────────
dist/
dist-ssr/
frontend/apps/*/dist/
*.local

# ── 环境变量与真实配置（只提交 .example）────────────────────
.env
.env.local
.env.*.local
!.env.example
backend/config/settings.local.yaml
backend/config/settings.*.yaml
!backend/config/settings.example.yaml
*.pem
*.key
*.p12

# ── 本地工具数据（含会话记忆与日志，不入库）─────────────────
.workbuddy/
# ── 日志 ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── 运行时缓存 ──────────────────────────────────────────────
.cache/
.vite/
.vite-inspect/
*.tsbuildinfo
coverage/
.nyc_output/

# ── Python / 后端 ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.db
*.sqlite3

# ── 编辑器与系统 ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 部署临时文件 ────────────────────────────────────────────
frontend/*-dist.tar.gz
*-dist.tar.gz
deploy/docker/.env
deploy/docker/data/
.qoder-credits/
